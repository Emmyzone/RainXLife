# ==========================================
# RainXLife environment configuration
# Copy this file to .env for local development.
# On Render, set these in the "Environment" tab instead of using a .env file.
# ==========================================

# Port the server listens on (Render sets this automatically in production)
PORT=3000

# Used to sign login session cookies. Use a long random string.
# Generate one locally with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_this_to_a_long_random_string

# Admin login credentials (used only by the create-admin script, see README)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose_a_strong_password

# Public site info
SITE_URL=http://localhost:3000
SITE_NAME=RainXLife

# Social links (shown in footer/nav, optional)
TIKTOK_URL=https://www.tiktok.com/@yourhandle
YOUTUBE_URL=https://www.youtube.com/@yourhandle

# Google AdSense (leave blank until your site is approved)
ADSENSE_CLIENT_ID=
ADSENSE_ENABLED=false

# SQLite database file path (relative to project root)
DATABASE_PATH=./data/rainxlife.db
