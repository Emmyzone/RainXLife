<a href="/books/<%= item.slug %>" class="article-card">
  <div class="article-card-cover">
    <% if (item.cover_image) { %>
      <img src="<%= item.cover_image %>" alt="<%= item.book_title %> cover" loading="lazy">
    <% } else { %>
      <div class="cover-placeholder"><span><%= item.book_title %></span></div>
    <% } %>
  </div>
  <div class="article-card-body">
    <% if (item.category_name) { %><span class="tag"><%= item.category_name %></span><% } %>
    <h3><%= item.title %></h3>
    <p class="article-card-author">by <%= item.author %></p>
    <p class="article-card-excerpt"><%= item.excerpt %></p>
    <div class="article-card-meta">
      <span><%= item.reading_time %> min read</span>
      <span>&middot;</span>
      <span><%= new Date(item.publication_date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></span>
    </div>
  </div>
</a>
